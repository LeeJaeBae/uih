{
  "name": "uih",
  "version": "0.7.1",
  "description": "UIH is a universal UI meta-language that bridges human-written interface descriptions and AI-generated components.",
  "keywords": [
    "uih",
    "ui",
    "meta-language",
    "ai",
    "components"
  ],
  "author": "LeeJaeWon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeJaeBae/uih.git"
  },
  "homepage": "https://github.com/LeeJaeBae/uih#readme",
  "bugs": {
    "url": "https://github.com/LeeJaeBae/uih/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter uih-cli dev",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "uih-cli": "workspace:*"
  }
}
