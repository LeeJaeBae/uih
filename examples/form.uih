meta {
  route: "/form";
  theme: "light";
}

layout "centered" {
  Card { "User Registration Form" }

  Label(htmlFor:"name") { "Name" }
  Input(id:"name", placeholder:"Enter your name", type:"text")

  Label(htmlFor:"email") { "Email" }
  Input(id:"email", placeholder:"Enter your email", type:"email")

  Label(htmlFor:"bio") { "Bio" }
  Textarea(id:"bio", placeholder:"Tell us about yourself", rows:"4")

  Separator

  Checkbox(id:"newsletter", label:"Subscribe to newsletter")
  Switch(id:"notifications", label:"Enable notifications")

  Separator

  Alert(variant:"default", title:"Important") { "Please fill all fields before submitting." }
  
  Progress(value:"60")

  Button(variant:"primary") { "Submit" }
}

logic {
  on submit {
    toast: "Form submitted successfully!";
    navigate: "/success";
  }
}
