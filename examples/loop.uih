meta {
  route: "/loop";
  theme: "light";
}

layout "centered" {
  Card { "User List" }

  for (user in users) {
    Card(id:user.id) { user.name }
    Label(htmlFor:"email") { "Email" }
    Text { user.email }
    Badge(variant:"default") { user.status }
  }

  Card { "Product List" }

  for (product in products) {
    Card(id:product.id) { product.name }
    Text { product.price }
    Button(variant:"primary") { "Buy" }
  }
}
