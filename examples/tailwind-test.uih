meta {
  route: "/tailwind-test";
  theme: "light";
}

style {
  color.primary: "#0E5EF7";
  color.secondary: "#64748b";
  color.success: "#10b981";
  spacing.card: "1.5rem";
}

layout {
  Text(class:"text-3xl font-bold text-gray-900 mb-6") { "Tailwind + CSS 변수 테스트" }

  Card(class:"bg-white shadow-lg rounded-lg p-6 border-l-4 border-[var(--color-primary)] mb-6") {
    "CSS 변수로 정의된 primary 색상을 사용하는 카드입니다."
  }

  Text(class:"text-xl font-semibold mb-4") { "버튼 스타일 예제" }

  Button(class:"bg-[var(--color-primary)] hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-4", variant:"primary") {
    "Primary 버튼"
  }

  Button(class:"bg-[var(--color-secondary)] hover:bg-gray-700 text-white font-bold py-2 px-4 rounded mr-4", variant:"secondary") {
    "Secondary 버튼"
  }

  Button(class:"bg-[var(--color-success)] hover:bg-green-700 text-white font-bold py-2 px-4 rounded mb-6") {
    "Success 버튼"
  }

  Text(class:"text-xl font-semibold mb-4") { "입력 필드 예제" }

  Input(placeholder:"Tailwind 스타일 적용된 Input", class:"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent mb-4")

  Badge(class:"inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold") {
    "Badge with Tailwind"
  }
}
