exports[`Svelte Code Generator > Data Block > should generate fetch in onMount 1`] = `
"<script lang="ts">
  import { onMount } from "svelte";
  let users = null;
  let usersLoading = true;
  let usersError = null;

  onMount(async () => {
    try {
      const response = await fetch("/api/users");
      users = await response.json();
    } catch (err) {
      usersError = err;
    } finally {
      usersLoading = false;
    }
  });
</script>

<div class="container mx-auto p-6">
  <p>Users loaded</p>
</div>
"
`;

