exports[`Svelte Code Generator > Complete Integration > should generate complete Svelte component with all features 1`] = `
"<script lang="ts">
  import CustomHeader from "./components/Header";
  import { onMount } from "svelte";
  let count = 0;

  let users = null;
  let usersLoading = true;
  let usersError = null;

  onMount(async () => {
    try {
      const response = await fetch("/api/users");
      users = await response.json();
    } catch (err) {
      usersError = err;
    } finally {
      usersLoading = false;
    }
  });
</script>

<div class="container mx-auto p-6">
  <CustomHeader />
  <p class="text-2xl font-bold">
    Count: {count}
  </p>
</div>

<style>
  :root {
    --color-primary: #0e5ef7;
  }
</style>
"
`;

