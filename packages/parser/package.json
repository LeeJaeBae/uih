{
  "name": "uih-parser",
  "version": "0.7.4",
  "description": "UIH language parser - converts .uih files to AST using Chevrotain",
  "keywords": [
    "uih",
    "parser",
    "ast",
    "chevrotain",
    "meta-language",
    "ui"
  ],
  "author": "LeeJaeWon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeJaeBae/uih.git",
    "directory": "packages/parser"
  },
  "homepage": "https://github.com/LeeJaeBae/uih/tree/main/packages/parser#readme",
  "bugs": {
    "url": "https://github.com/LeeJaeBae/uih/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "test": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "exports": {
    ".": {
      "import": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "chevrotain": "^11.0.3"
  }
}
