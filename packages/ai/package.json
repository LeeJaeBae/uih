{
  "name": "uih-ai",
  "version": "0.7.1",
  "description": "AI-powered natural language to UIH code generator using Claude API",
  "keywords": [
    "uih",
    "ai",
    "claude",
    "code-generator",
    "natural-language",
    "llm"
  ],
  "author": "LeeJaeWon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeJaeBae/uih.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/LeeJaeBae/uih/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/LeeJaeBae/uih/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "test": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.0",
    "chevrotain": "^11.0.3",
    "uih-parser": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
