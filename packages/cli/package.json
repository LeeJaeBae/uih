{
  "name": "uih-cli",
  "version": "0.7.1",
  "description": "Command-line interface for UIH - compile, validate, and watch .uih files",
  "keywords": [
    "uih",
    "cli",
    "compiler",
    "build-tool",
    "code-generator",
    "react",
    "vue"
  ],
  "author": "LeeJaeWon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeJaeBae/uih.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/LeeJaeBae/uih/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/LeeJaeBae/uih/issues"
  },
  "type": "module",
  "bin": {
    "uih": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "dev": "node dist/index.js --watch examples/booking.uih",
    "test": "vitest"
  },
  "dependencies": {
    "uih-codegen-react": "workspace:*",
    "uih-parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "chokidar": "^4.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
