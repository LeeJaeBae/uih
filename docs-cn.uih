meta {
  route: "/docs/cn";
  title: "UIH文档";
  theme: "light";
}

style {
  color.primary: "#0E5EF7";
  color.secondary: "#6B7280";
  color.accent: "#10B981";
}

layout {
  Div(class:"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800") {
    Header(class:"bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700") {
      Div(class:"container mx-auto px-6 py-4") {
        Div(class:"flex items-center justify-between") {
          Div(class:"flex items-center space-x-3") {
            Div(class:"w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center") {
              Span(class:"text-white font-bold text-xl") { "U" }
            }
            H1(class:"text-2xl font-bold text-gray-900 dark:text-white") { "UIH文档" }
          }
          Div(class:"flex items-center space-x-2") {
            A(href:"/docs/ko", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "한국어" }
            A(href:"/docs/en", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "English" }
            A(href:"/docs/jp", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "日本語" }
            A(href:"/docs/cn", class:"px-3 py-2 rounded-lg bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100 font-medium") { "中文" }
          }
        }
      }
    }

    Main(class:"container mx-auto px-6 py-12") {
      Div(class:"max-w-4xl mx-auto") {
        Section(class:"mb-16 text-center") {
          H2(class:"text-5xl font-extrabold text-gray-900 dark:text-white mb-4") { "Universal UI Hierarchy" }
          P(class:"text-xl text-gray-600 dark:text-gray-300 mb-8") { "React、Vue和Svelte的统一UI元语言" }
          Div(class:"flex justify-center space-x-4") {
            A(href:"/editor", class:"px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-lg transition-all") { "在编辑器中开始 →" }
            A(href:"https://github.com/LeeJaeBae/uih", target:"_blank", rel:"noopener noreferrer", class:"px-8 py-3 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-lg border border-gray-300 dark:border-gray-600 transition-all") { "在GitHub上查看" }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "✨ 主要特性" }
          Div(class:"grid grid-cols-1 md:grid-cols-2 gap-6") {
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🎨" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "完整的Tailwind CSS支持" }
              P(class:"text-gray-600 dark:text-gray-300") { "支持所有Tailwind实用程序类和CSS变量。" }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🔄" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "多框架支持" }
              P(class:"text-gray-600 dark:text-gray-300") { "可同时编译为React、Vue和Svelte。" }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "⚡" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "交互式模板" }
              P(class:"text-gray-600 dark:text-gray-300") { "自动生成state、验证和API逻辑。" }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🤖" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "AI友好" }
              P(class:"text-gray-600 dark:text-gray-300") { "与Claude Code集成，可用自然语言生成UI。" }
            }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "🚀 快速开始" }
          Div(class:"bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg border border-gray-200 dark:border-gray-700") {
            Div(class:"mb-8") {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "1" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "安装" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "npm install -g uih-cli" }
              }
            }
            Div(class:"mb-8") {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "2" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "编写UIH文件" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "meta {\n  route: \"/hello\";\n}\n\nlayout {\n  Card(class:\"p-6\") {\n    H1 { \"你好世界！\" }\n  }\n}" }
              }
            }
            Div {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "3" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "编译" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "uih compile hello.uih out --target react" }
              }
            }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "📝 基本语法" }
          Div(class:"space-y-6") {
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Meta块" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "定义页面元数据。" }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "meta {\n  route: \"/about\";\n  title: \"关于\";\n  theme: \"light\";\n}" }
              }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Style块" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "定义CSS变量。" }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "style {\n  color.primary: \"#0E5EF7\";\n  color.secondary: \"#6B7280\";\n}" }
              }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Layout块" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "定义UI结构。" }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "layout {\n  Div(class:\"container\") {\n    H1 { \"标题\" }\n    P { \"内容\" }\n  }\n}" }
              }
            }
          }
        }

        Section {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "🔗 了解更多" }
          Div(class:"grid grid-cols-1 md:grid-cols-3 gap-6") {
            A(href:"https://github.com/LeeJaeBae/uih", target:"_blank", rel:"noopener noreferrer", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "GitHub" }
              P(class:"text-gray-600 dark:text-gray-300") { "源代码和问题跟踪" }
            }
            A(href:"/editor", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "Playground" }
              P(class:"text-gray-600 dark:text-gray-300") { "在浏览器中立即试用" }
            }
            A(href:"https://www.npmjs.com/package/uih-cli", target:"_blank", rel:"noopener noreferrer", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "NPM" }
              P(class:"text-gray-600 dark:text-gray-300") { "包和安装指南" }
            }
          }
        }
      }
    }

    Footer(class:"bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16") {
      Div(class:"container mx-auto px-6 py-8") {
        Div(class:"text-center text-gray-600 dark:text-gray-400") {
          P { "© 2024 UIH. MIT License." }
          P(class:"mt-2") {
            Span { "Made with ❤️ by " }
            A(href:"https://github.com/LeeJaeBae", target:"_blank", rel:"noopener noreferrer", class:"text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300") { "LeeJaeWon" }
          }
        }
      }
    }
  }
}
