meta {
  route: "/docs/en";
  title: "UIH Documentation";
  theme: "light";
}

style {
  color.primary: "#0E5EF7";
  color.secondary: "#6B7280";
  color.accent: "#10B981";
}

layout {
  Div(class:"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800") {
    Header(class:"bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700") {
      Div(class:"container mx-auto px-6 py-4") {
        Div(class:"flex items-center justify-between") {
          Div(class:"flex items-center space-x-3") {
            Div(class:"w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center") {
              Span(class:"text-white font-bold text-xl") { "U" }
            }
            H1(class:"text-2xl font-bold text-gray-900 dark:text-white") { "UIH Documentation" }
          }
          Div(class:"flex items-center space-x-2") {
            A(href:"/docs/ko", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "한국어" }
            A(href:"/docs/en", class:"px-3 py-2 rounded-lg bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100 font-medium") { "English" }
            A(href:"/docs/jp", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "日本語" }
            A(href:"/docs/cn", class:"px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300") { "中文" }
          }
        }
      }
    }

    Main(class:"container mx-auto px-6 py-12") {
      Div(class:"max-w-4xl mx-auto") {
        Section(class:"mb-16 text-center") {
          H2(class:"text-5xl font-extrabold text-gray-900 dark:text-white mb-4") { "Universal UI Hierarchy" }
          P(class:"text-xl text-gray-600 dark:text-gray-300 mb-8") { "Unified UI Meta Language for React, Vue, and Svelte" }
          Div(class:"flex justify-center space-x-4") {
            A(href:"/editor", class:"px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-lg transition-all") { "Start in Editor →" }
            A(href:"https://github.com/LeeJaeBae/uih", target:"_blank", rel:"noopener noreferrer", class:"px-8 py-3 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-lg border border-gray-300 dark:border-gray-600 transition-all") { "View on GitHub" }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "✨ Key Features" }
          Div(class:"grid grid-cols-1 md:grid-cols-2 gap-6") {
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🎨" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "Full Tailwind CSS Support" }
              P(class:"text-gray-600 dark:text-gray-300") { "Supports all Tailwind utility classes and CSS variables." }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🔄" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "Multi-Framework" }
              P(class:"text-gray-600 dark:text-gray-300") { "Compile to React, Vue, and Svelte simultaneously." }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "⚡" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "Interactive Templates" }
              P(class:"text-gray-600 dark:text-gray-300") { "Auto-generates state, validation, and API logic." }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              Div(class:"text-4xl mb-4") { "🤖" }
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "AI-Friendly" }
              P(class:"text-gray-600 dark:text-gray-300") { "Integrated with Claude Code for natural language UI generation." }
            }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "🚀 Quick Start" }
          Div(class:"bg-white dark:bg-gray-800 rounded-xl p-8 shadow-lg border border-gray-200 dark:border-gray-700") {
            Div(class:"mb-8") {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "1" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "Install" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "npm install -g uih-cli" }
              }
            }
            Div(class:"mb-8") {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "2" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "Write UIH File" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "meta {\n  route: \"/hello\";\n}\n\nlayout {\n  Card(class:\"p-6\") {\n    H1 { \"Hello World!\" }\n  }\n}" }
              }
            }
            Div {
              Div(class:"flex items-center mb-4") {
                Span(class:"w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mr-3") { "3" }
                H4(class:"text-xl font-bold text-gray-900 dark:text-white") { "Compile" }
              }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "uih compile hello.uih out --target react" }
              }
            }
          }
        }

        Section(class:"mb-16") {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "📝 Basic Syntax" }
          Div(class:"space-y-6") {
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Meta Block" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "Define page metadata." }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "meta {\n  route: \"/about\";\n  title: \"About\";\n  theme: \"light\";\n}" }
              }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Style Block" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "Define CSS variables." }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "style {\n  color.primary: \"#0E5EF7\";\n  color.secondary: \"#6B7280\";\n}" }
              }
            }
            Div(class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-3") { "Layout Block" }
              P(class:"text-gray-600 dark:text-gray-300 mb-4") { "Define UI structure." }
              Pre(class:"bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto") {
                Code { "layout {\n  Div(class:\"container\") {\n    H1 { \"Title\" }\n    P { \"Content\" }\n  }\n}" }
              }
            }
          }
        }

        Section {
          H3(class:"text-3xl font-bold text-gray-900 dark:text-white mb-8") { "🔗 Learn More" }
          Div(class:"grid grid-cols-1 md:grid-cols-3 gap-6") {
            A(href:"https://github.com/LeeJaeBae/uih", target:"_blank", rel:"noopener noreferrer", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "GitHub" }
              P(class:"text-gray-600 dark:text-gray-300") { "Source code and issue tracker" }
            }
            A(href:"/editor", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "Playground" }
              P(class:"text-gray-600 dark:text-gray-300") { "Try it right in your browser" }
            }
            A(href:"https://www.npmjs.com/package/uih-cli", target:"_blank", rel:"noopener noreferrer", class:"bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-500 transition-all") {
              H4(class:"text-xl font-bold text-gray-900 dark:text-white mb-2") { "NPM" }
              P(class:"text-gray-600 dark:text-gray-300") { "Package and installation guide" }
            }
          }
        }
      }
    }

    Footer(class:"bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16") {
      Div(class:"container mx-auto px-6 py-8") {
        Div(class:"text-center text-gray-600 dark:text-gray-400") {
          P { "© 2024 UIH. MIT License." }
          P(class:"mt-2") {
            Span { "Made with ❤️ by " }
            A(href:"https://github.com/LeeJaeBae", target:"_blank", rel:"noopener noreferrer", class:"text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300") { "LeeJaeWon" }
          }
        }
      }
    }
  }
}
